# Template only. Do not start a public service with placeholder values.
OPO_MODE=catalog
HOST=127.0.0.1
PORT=3200
OPO_ORIGIN=https://REPLACE_WITH_CONFIRMED_HOST
OPO_OPERATOR_NAME=OPO
OPO_SUPPORT_EMAIL=guiguowang99@gmail.com
OPO_INQUIRY_RETENTION_DAYS=30
# Verify the proxy addresses actually seen by Node.
OPO_TRUSTED_PROXIES=127.0.0.1,::1
OPO_DATABASE=/var/lib/opo/opo.db
OPO_MFA_KEY_FILE=/etc/opo/mfa-key
OPO_BACKUP_KEY_FILE=/etc/opo/backup-key
OPO_BACKUP_DIR=/var/lib/opo/backups-encrypted
