# Confirmed public contact details plus deployment placeholders; replace the domain/proxy values before deployment.
OPO_MODE=catalog
OPO_ORIGIN=https://www.opo3market.com
# OPO is the user-confirmed platform/contact display name, not a registered-company claim.
OPO_OPERATOR_NAME=OPO
OPO_SUPPORT_EMAIL=guiguowang99@gmail.com
OPO_INQUIRY_RETENTION_DAYS=30
# Exact IP addresses of the reverse proxy as observed by Node; no wildcard/CIDR.
OPO_TRUSTED_PROXIES=127.0.0.1,::1
# On bare Node, set OPO_MFA_KEY_FILE to an absolute private file path.
# Docker Compose mounts the file automatically from .secrets/mfa-key.
